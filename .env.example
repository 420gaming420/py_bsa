# Environment configuration for py_bsa game tests
# Copy this file to .env and fill in your paths

# Windows path to BSArch.exe (used by wine on Linux)
# Format: Z:/path/to/BSArch.exe (Windows-style path as seen by wine)
# Download BSArch from: https://github.com/TES5Edit/TES5Edit
BSARCH_EXE_WIN=./BSArch.exe
